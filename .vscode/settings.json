{
  "yaml.customTags": [
    "!And",
    "!If",
    "!Not",
    "!Equals",
    "!Or",
    "!FindInMap sequence",
    "!Base64",
    "!Cidr",
    "!Ref",
    "!Sub",
    "!GetAtt",
    "!GetAZs",
    "!ImportValue",
    "!Select",
    "!Split",
    "!Join sequence"
  ],
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
  },
  // Configuración para GitHub Actions
  "yaml.validate": true,
  "yaml.format.enable": true,
  "github-actions.workflows.pinned.workflows": [
    ".github/workflows/sync-to-deployment.yml"
  ],
  // Silenciar advertencias específicas de compilación para secrets de GitHub Actions
  "typescript.validate.enable": true,
  "javascript.validate.enable": true
}
